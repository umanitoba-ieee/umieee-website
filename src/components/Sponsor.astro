---
interface Props {
  name: string;
  image: string;
  href?: string;
}

const { name, image, href } = Astro.props;
---
{href ? (
  <a href={href} target="_blank" rel="noopener noreferrer" aria-label={name} class="sponsor-link">
    <img src={image} alt={name} loading="lazy" />
  </a>
) : (
  <span class="sponsor-link" aria-label={name}>
    <img src={image} alt={name} loading="lazy" />
  </span>
)}
