---
import { Image } from 'astro:assets';

const images = import.meta.glob(
  '../content/hero-gallery/*.{jpg,jpeg,png,webp,gif,avif}',
  {
    eager: true,
    import: 'default',
  }
);

const galleryImages = Object.values(images);
---

<div class="fade-gallery" data-fade-gallery>
  {galleryImages.map((image, index) => (
    <Image src={image} alt="" class:list={{ active: index === 0 }} />
  ))}
</div>

<script>
const IMAGE_TRANSITION_TIME = 5000;

document
  .querySelectorAll<HTMLElement>('[data-fade-gallery]')
  .forEach((gallery) => {
    const images = Array.from(
      gallery.querySelectorAll<HTMLImageElement>('img')
    );

    let currentIndex = 0;

    if (images.length <= 1) return;

    window.setInterval(() => {
      images[currentIndex].classList.remove('active');
      currentIndex = (currentIndex + 1) % images.length;
      images[currentIndex].classList.add('active');
    }, IMAGE_TRANSITION_TIME);
  });
</script>