---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | UMIEEE">
  <main class="error-page">
    <div class="error-content">
        
      <img src="/assets/logo_no_text.svg" alt="IEEE Logo" class="error-logo" />

      <h1>404</h1>
      <h2>Page Not Found</h2>
      <p>The page you're looking for doesn't exist or may have been moved.</p>

      <a href="/" class="error-button">
        Return Home
      </a>

    </div>
  </main>
</Layout>

<style>
.error-page {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60px 24px;
  text-align: center;
}

.error-content {
  width: 100%;
  max-width: 600px;
}

.error-logo {
  display: block;
  width: 100%;
  max-width: 300px;
  height: auto;
  margin: 0 auto 24px;
  padding: 0 24px;
  box-sizing: border-box;
}

.error-content h1 {
  margin: 0;
  color: #003b5c;
  font-size: clamp(3.5rem, 12vw, 6rem);
  line-height: 1;
}

.error-content h2 {
  margin: 12px 0 0;
  color: #00629b;
  font-size: clamp(1.5rem, 5vw, 2rem);
}

.error-content p {
  margin: 16px auto 0;
  max-width: 450px;
  color: #666;
  font-size: 1.05rem;
}

.error-button {
  display: inline-block;
  margin-top: 30px;
  padding: 12px 28px;
  border-radius: 6px;
  background-color: #00629b;
  color: #fff;
  font-weight: 600;
  text-decoration: none;
  transition: background-color 0.3s ease;
}

.error-button:hover {
  background-color: #003b5c;
}

@media (max-width: 480px) {
  .error-page {
    min-height: 65vh;
    padding: 40px 16px;
  }

  .error-logo {
    max-width: 220px;
    padding: 0 16px;
  }
}
</style>